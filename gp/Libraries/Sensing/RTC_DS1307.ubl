module 'RTC (DS1307)'
author 'Ralf Krause'
version 1 0 
choices DS1307_m12 'a.m.' 'p.m.'
description 'RTC (DS1307)

The DS1307 is an i2c device (0x68) with a clock, a calendar, and 56 bytes of battery-backed SRAM. The DS1307 provides seconds, minutes, hours, weekday, day, month, and year. The end of a month is automatically adjusted for months with fewer than 31 days, including corrections for leap years. 
https://www.analog.com/media/en/technical-documentation/data-sheets/ds1307.pdf
'

  spec 'r' 'RTC hour' 'RTC hour'
  spec 'r' 'RTC minute' 'RTC minute'
  spec 'r' 'RTC second' 'RTC second'
  spec 'r' 'RTC get time' 'RTC get time'
  spec ' ' 'RTC set time' 'RTC set time to _ _ _' 'num num num' 12 0 0
  space
  spec 'r' 'RTC hour12' 'RTC hour12'
  spec 'r' 'RTC get time12' 'RTC get time12'
  spec ' ' 'RTC set time12' 'RTC set time12 to _ _ _ _' 'num num num menu.DS1307_m12' 12 0 0 'a.m.'
  space
  spec 'r' 'RTC weekday' 'RTC weekday'
  spec 'r' 'RTC day' 'RTC day'
  spec 'r' 'RTC month' 'RTC month'
  spec 'r' 'RTC year' 'RTC year'
  spec 'r' 'RTC get date' 'RTC get date'
  spec ' ' 'RTC set date' 'RTC set date to _ _ _ _ (weekday day month year)' 'num num num num' 1 1 1 2025
  space
  spec 'r' '_RTC_address' '_RTC_address'
  spec ' ' '_RTC_start_clock' '_RTC_start_clock'
  spec ' ' '_RTC_stop_clock' '_RTC_stop_clock'
  spec 'r' '_RTC_bcd2dec' '_RTC_bcd2dec _' 'auto' '32'
  spec 'r' '_RTC_dec2bcd' '_RTC_dec2bcd _' 'auto' '16'
  spec 'r' '_RTC_00' '_RTC_00 _' 'auto' '7'

to 'RTC get time' {
  return ('[data:join]' ('_RTC_00' ('RTC hour')) ':' ('_RTC_00' ('RTC minute')) ':' ('_RTC_00' ('RTC second')))
}

to 'RTC hour' {
  return ('_RTC_bcd2dec' (i2cGet ('_RTC_address') 2))
}

to 'RTC minute' {
  return ('_RTC_bcd2dec' (i2cGet ('_RTC_address') 1))
}

to 'RTC second' {
  return ('_RTC_bcd2dec' ((i2cGet ('_RTC_address') 0) & (hexToInt '7F')))
}

to 'RTC get date' {
  return ('[data:join]' ('_RTC_00' ('RTC day')) '.' ('_RTC_00' ('RTC month')) '.' ('RTC year'))
}

to 'RTC weekday' {
  return ('_RTC_bcd2dec' (i2cGet ('_RTC_address') 3))
}

to 'RTC day' {
  return ('_RTC_bcd2dec' (i2cGet ('_RTC_address') 4))
}

to 'RTC month' {
  return ('_RTC_bcd2dec' (i2cGet ('_RTC_address') 5))
}

to 'RTC year' {
  return (2000 + ('_RTC_bcd2dec' (i2cGet ('_RTC_address') 6)))
}

to '_RTC_start_clock' {
  local 'second' (i2cGet ('_RTC_address') 0)
  i2cSet ('_RTC_address') 0 (second & (hexToInt '7F'))
}

to '_RTC_stop_clock' {
  local 'second' (i2cGet ('_RTC_address') 0)
  i2cSet ('_RTC_address') 0 (second | (hexToInt '80'))
}

to 'RTC set time' hour minute second {
  local 'time' ('[data:makeList]' 0)
  '[data:addLast]' ('_RTC_dec2bcd' (second % 60)) time
  '[data:addLast]' ('_RTC_dec2bcd' (minute % 60)) time
  '[data:addLast]' ('_RTC_dec2bcd' (hour % 24)) time
  '[sensors:i2cWrite]' ('_RTC_address') time
}

to 'RTC set date' Weekday day month year {
  local 'date' ('[data:makeList]' 3)
  '[data:addLast]' ('_RTC_dec2bcd' (Weekday % 8)) date
  '[data:addLast]' ('_RTC_dec2bcd' (day % 32)) date
  '[data:addLast]' ('_RTC_dec2bcd' (month % 13)) date
  '[data:addLast]' ('_RTC_dec2bcd' (year % 2000)) date
  '[sensors:i2cWrite]' ('_RTC_address') date
}

to 'RTC get time12' {
  local 'hour' ('[data:split]' ('RTC hour12') ' ')
  return ('[data:join]' (at 1 hour) ':' ('_RTC_00' ('RTC minute')) ':' ('_RTC_00' ('RTC second')) ' ' (at 2 hour))
}

to 'RTC hour12' {
  local 'hour' ('RTC hour')
  local 'm' 'a.m.'
  if (or (hour > 12) (hour == 0)) {
    m = 'p.m.'
    if (and (hour == 0) (or (('RTC minute') > 0) (('RTC second') > 0))) {
      m = 'a.m.'
    }
    hour = (hour % 12)
    if (hour == 0) {hour = 12}
  } else {
    if (and (hour == 12) (or (('RTC minute') > 0) (('RTC second') > 0))) {m = 'p.m.'}
  }
  return ('[data:join]' hour ' ' m)
}

to 'RTC set time12' hour minute second m {
  if (and (0 < hour) (hour <= 12)) {
    if (m == 'a.m.') {
      if (hour == 12) {if (or (minute > 0) (second > 0)) {
        hour = 0
      }}
    } else {
      if (hour == 12) {
        if (and (minute == 0) (second == 0)) {hour = 0}
      } else {
        hour = ((hour + 12) % 24)
      }
    }
    'RTC set time' hour minute second
  }
}

to '_RTC_address' {
  return (hexToInt '68')
}

to '_RTC_bcd2dec' val {
  return (((val / 16) * 10) + (val % 16))
}

to '_RTC_dec2bcd' val {
  return (((val / 10) * 16) + (val % 10))
}

to '_RTC_00' val {
  local 's' ''
  if (val < 10) {
    s = 0
  }
  s = ('[data:join]' s val)
  return s
}


