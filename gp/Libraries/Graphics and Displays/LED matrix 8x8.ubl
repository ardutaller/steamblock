module 'LED matrix 8x8' Output
author 'José García Yeste'
version 1 0 
description 'Suport for Keystudio KS0396 8x8 LED Matrix
It''s possible to use up to 8 modules

https://wiki.keyestudio.com/KS0396_keyestudio_8x8_LED_Matrix_Module_Address_Select
'
variables _lm8x8buf 

  spec ' ' 'lm8x8 clear' 'LED matrix 8x8 _ clear' 'menu.range:1-8' 1
  spec ' ' 'lm8x8 plot' 'LED matrix 8x8 _ plot x _ y _' 'menu.range:1-8 num num' 1 1 1
  spec ' ' 'lm8x8 unplot' 'LED matrix 8x8 _ unplot x _ y _' 'menu.range:1-8 num num' 1 1 1
  spec ' ' 'lm8x8 displayCharacter' 'LED matrix 8x8 _ display character _' 'menu.range:1-8 auto' 1 'A'
  spec ' ' 'lm8x8 displayDigit' 'LED matrix 8x8 _ display digit _' 'menu.range:1-8 num' 1 0
  space
  spec ' ' 'lm8x8 brightness' 'LED matrix 8x8 _ brightness _' 'menu.range:1-8 num' 1 10
  space
  spec ' ' '_lm8x8 setup' '_LED matrix 8x8 _ setup' 'menu.range:1-8' 1
  spec ' ' '_lm8x8 write' '_LED matrix 8x8 _ write _' 'menu.range:1-8 auto' 1 0
  spec ' ' '_lm8x8 update' '_LED matrix 8x8 _ update' 'menu.range:1-8' 1
  spec 'r' '_lm8x8 shape for digit' '_LED matrix 8x8 shape for digit _' 'num' 1

to '_lm8x8 setup' i2c {
  if (_lm8x8buf == 0) {_lm8x8buf = (newList 8 0)}
  if ((at i2c _lm8x8buf) == 0) {
    '_lm8x8 write' i2c (hexToInt '21')
    'lm8x8 brightness' i2c 10
    atPut i2c _lm8x8buf ('[data:newByteArray]' 8)
    '_lm8x8 update' i2c
    '_lm8x8 write' i2c (hexToInt '81')
  }
}

to '_lm8x8 shape for digit' digit {
  return ('[data:split]' (at (digit + 1) ('[data:makeList]' '38,44,4C,54,64,44,38' '10,30,10,10,10,10,38' '38,44,04,18,20,40,7C' '38,44,04,38,04,44,38' '08,18,28,48,7C,08,08' '7C,40,40,78,04,44,38' '18,20,40,78,44,44,38' '7C,04,08,10,20,20,20' '38,44,44,38,44,44,38' '38,44,44,3C,04,08,30')) ',')
}

to '_lm8x8 update' i2c {
  local 'buf' ('[data:newByteArray]' 17)
  for i 8 {
    atPut (i * 2) buf (at i (at i2c _lm8x8buf))
    atPut ((i * 2) + 1) buf (at i (at i2c _lm8x8buf))
  }
  '_lm8x8 write' i2c buf
}

to '_lm8x8 write' i2c data {
  comment '1=0x70, 8=0x77'
  '[sensors:i2cWrite]' (i2c + 111) data
}

to 'lm8x8 brightness' i2c brightness {
  '_lm8x8 write' i2c ((hexToInt 'E0') | brightness)
}

to 'lm8x8 clear' i2c {
  '_lm8x8 setup' i2c
  atPut 'all' (at i2c _lm8x8buf) 0
  '_lm8x8 update' i2c
}

to 'lm8x8 displayCharacter' i2c char {
  '_lm8x8 setup' i2c
  local 'shape' ('[display:mbShapeForLetter]' ('[data:toString]' char))
  local 'mask' 1
  local 'x' 1
  local 'y' 1
  atPut 'all' (at i2c _lm8x8buf) 0
  for c 5 {
    for f 5 {
      if ((shape & mask) != 0) {atPut (9 - (y + c)) (at i2c _lm8x8buf) ((at (9 - (y + c)) (at i2c _lm8x8buf)) | (1 << ((x + f) - 1)))}
      mask = (mask << 1)
    }
  }
  '_lm8x8 update' i2c
}

to 'lm8x8 displayDigit' i2c digit {
  comment 'https://github.com/idispatch/raster-fonts/blob/master/font-6x8.c'
  '_lm8x8 setup' i2c
  if (and (digit >= 0) (digit < 10)) {
    local 'x' 0
    local 'y' 0
    atPut 'all' (at i2c _lm8x8buf) 0
    for f 7 {
      local 'mask' 128
      local 'shape' (hexToInt (at f ('_lm8x8 shape for digit' digit)))
      for c 6 {
        if ((shape & mask) != 0) {atPut (9 - (y + f)) (at i2c _lm8x8buf) ((at (9 - (y + f)) (at i2c _lm8x8buf)) | (1 << ((x + c) - 1)))}
        mask = (mask >> 1)
      }
    }
    '_lm8x8 update' i2c
  }
}

to 'lm8x8 plot' i2c x y {
  '_lm8x8 setup' i2c
  if (and (x > 0) (and (y > 0) (and (x < 9) (y < 9)))) {
    atPut (9 - y) (at i2c _lm8x8buf) ((at (9 - y) (at i2c _lm8x8buf)) | (1 << (x - 1)))
    '_lm8x8 update' i2c
  }
}

to 'lm8x8 unplot' i2c x y {
  '_lm8x8 setup' i2c
  if (and (x > 0) (and (y > 0) (and (x < 9) (y < 9)))) {
    atPut (9 - y) (at i2c _lm8x8buf) ((at (9 - y) (at i2c _lm8x8buf)) & ('~' (1 << (x - 1))))
    '_lm8x8 update' i2c
  }
}

