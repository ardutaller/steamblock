module 'Analog Synthesis' Operators
author MicroBlocks
version 1 0 
description ''
variables _asynth_trigger_times _asynth_frequencies _asynth_frequency_table _asynth_amplitudes _asynth_attacks _asynth_holds _asynth_releases 

  spec 'r' 'asynth sin' 'sin wave gate _' 'menu.range:1-20' 1
  spec 'r' 'asynth square' 'square wave gate _' 'menu.range:1-20' 1
  spec 'r' 'asynth tri' 'tri wave gate _' 'menu.range:1-20' 1
  spec 'r' 'asynth saw' 'sawtooth wave gate _' 'menu.range:1-20' 1
  spec 'r' 'asynth noise' 'noise gate _' 'menu.range:1-20' 1
  space
  spec ' ' 'asynth envelope' 'set amplitude _ attack _ hold _ release _ for gate _' 'num num num num menu.range:1-20' 200 10 250 100 1
  spec ' ' 'asynth trigger gate' 'trigger gate _ MIDI key _' 'menu.range:1-20 num' 1 60
  space
  spec ' ' '_asynth init' '_asynth init'
  spec 'r' '_asynth amplitude' '_asynth amplitude for gate _' 'menu.range:1-20' 1
  spec 'r' '_asynth MIDI to freq' '_asynth MIDI note _ to frequency' 'auto' 60

to '_asynth amplitude' gate {
  '_asynth init'
  local 'start time' (at gate _asynth_trigger_times)
  local 'amp' (at gate _asynth_amplitudes)
  local 'att' (at gate _asynth_attacks)
  local 'hold' (at gate _asynth_holds)
  local 'release' (at gate _asynth_releases)
  if ((millisOp) < (v 'start time')) {
    return 0
  } ((millisOp) > (((v 'start time') + att) + (hold + release))) {
    comment 'all done, no sound'
    return 0
  } ((millisOp) > (((v 'start time') + att) + hold)) {
    comment 'release time'
    return (amp - ((amp * ((millisOp) - (((v 'start time') + att) + hold))) / release))
  } ((millisOp) > ((v 'start time') + att)) {
    comment 'hold time'
    return amp
  } else {
    comment 'attack time'
    return ((amp * ((millisOp) - (v 'start time'))) / att)
  }
}

to '_asynth init' {
  if (_asynth_trigger_times == 0) {_asynth_trigger_times = (newList 20)}
  if (_asynth_frequencies == 0) {_asynth_frequencies = (newList 20)}
  if (_asynth_amplitudes == 0) {_asynth_amplitudes = (newList 20)}
  if (_asynth_attacks == 0) {_asynth_attacks = (newList 20)}
  if (_asynth_holds == 0) {_asynth_holds = (newList 20)}
  if (_asynth_releases == 0) {_asynth_releases = (newList 20)}
}

to '_asynth MIDI to freq' key {
  local 'semitone' ((key % 12) + 1)
  local 'octave' ((key / 12) - 5)
  if (_asynth_frequency_table == 0) {
    _asynth_frequency_table = ('[data:makeList]' 261626 277183 293665 311127 329628 349228 369994 391995 415305 440000 466164 493883 246942 277183 277183 311127 311127 349228 329628 369994 369994 415305 415305 466164 466164 523252)
  }
  if (and (1 <= semitone) (semitone <= (size _asynth_frequency_table))) {
    local 'freq' (at semitone _asynth_frequency_table)
    if (octave < 0) {
      repeat (absoluteValue octave) {
        freq = (freq / 2)
      }
    }
    repeat octave {
      freq = (freq * 2)
    }
    return (freq / 1000)
  } else {
    return 10000
  }
}

to 'asynth envelope' amp att hold release gate {
  '_asynth init'
  atPut gate _asynth_amplitudes amp
  atPut gate _asynth_attacks att
  atPut gate _asynth_holds hold
  atPut gate _asynth_releases release
}

to 'asynth noise' gate {
  local 'amp' ('_asynth amplitude' gate)
  if (amp < 1) {
    return 0
  }
  return (random 1 amp)
}

to 'asynth saw' gate {
  local 'amp' ('_asynth amplitude' gate)
  local 'freq' (at gate _asynth_frequencies)
  if (amp < 1) {
    return 0
  }
  return ((((microsOp) * amp) / (1000000 / freq)) % amp)
}

to 'asynth sin' gate {
  local 'amp' ('_asynth amplitude' gate)
  local 'freq' (at gate _asynth_frequencies)
  if (amp < 1) {
    return 0
  }
  return ((amp / 2) + (((amp / 2) * ('[misc:sin]' (9 * ((microsOp) % (1000000 / freq))))) >> 14))
}

to 'asynth square' gate {
  local 'amp' ('_asynth amplitude' gate)
  local 'freq' (at gate _asynth_frequencies)
  if (amp < 1) {
    return 0
  }
  local 'ms' (1000000 / freq)
  return (('[data:convertType]' (((microsOp) % ms) > (ms / 2)) 'number') * amp)
}

to 'asynth tri' gate {
  local 'amp' ('_asynth amplitude' gate)
  local 'freq' (at gate _asynth_frequencies)
  comment (absoluteValue ((i % ms) - (ms / 2)))
  if (amp < 1) {
    return 0
  }
  return (amp - (absoluteValue (amp - (2 * ((((microsOp) * amp) / (1000000 / freq)) % amp)))))
}

to 'asynth trigger gate' index key {
  atPut index _asynth_trigger_times (millisOp)
  atPut index _asynth_frequencies ('_asynth MIDI to freq' key)
  comment 'Force a yield'
  waitMillis 1
}

