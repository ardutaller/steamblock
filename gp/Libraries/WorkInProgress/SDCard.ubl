module SDCard Data
author MicroBlocks
version 1 1 
description 'SDCard file system operations. Similar to the File library, but for SD Cards..'

  spec ' ' '[sd:init]' 'set SD card chip select pin _' 'num' -1
  space
  spec ' ' '[sd:open]' 'open sd file _' 'str'
  spec ' ' '[sd:close]' 'close sd file _' 'str'
  spec ' ' '[sd:delete]' 'delete sd file _' 'str'
  space
  spec ' ' '[sd:appendLine]' 'append line _ to sd file _' 'str str'
  spec ' ' '[sd:appendBytes]' 'append bytes _ to sd file _' 'str str'
  space
  spec 'r' '[sd:endOfFile]' 'end of sd file _' 'str'
  spec 'r' '[sd:readLine]' 'next line of sd file _' 'str'
  spec 'r' '[sd:readBytes]' 'next _ bytes of sd file _ : starting at _' 'num str num' 100 '' 0
  spec 'r' '[sd:readInto]' 'read into _ from sd file _' 'str str' 'a ByteArray' ''
  space
  spec 'r' '[sd:readPosition]' 'read position of sd file _' 'str'
  spec ' ' '[sd:setReadPosition]' 'set read position _ of sd file _' 'num str' 0 ''
  spec ' ' 'sdCard_skipBytes' 'skip _ bytes of sd file _' 'num str' 4 ''
  space
  spec 'r' 'sdCard_fileNames' 'sd file names : in directory _' 'str'
  spec 'r' '[sd:fileSize]' 'size of sd file _' 'str'

to sdCard_fileNames dir {
  '[sd:startList]' dir
  local 'result' ('[data:makeList]')
  local 'fileName' ('[sd:nextInList]')
  repeatUntil (fileName == '') {
    '[data:addLast]' fileName result
    fileName = ('[sd:nextInList]')
  }
  return result
}

to sdCard_skipBytes offset file {
  local 'newPosition' (('[sd:readPosition]' file) + offset)
  '[sd:setReadPosition]' newPosition file
}

