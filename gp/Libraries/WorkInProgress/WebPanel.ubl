module WebPanel Data
author MicroBlocks
version 1 1 
depends '_HTTP server' _Strings WiFi 
description 'Quickly create a web panel that shows auto-updating readouts of sensor values and buttons to trigger actions.'
variables _webpnl_readouts _webpnl_buttons _webpnl_title _webpnl_page_cache _webpnl_css_style 

  spec ' ' 'webpnl set title' 'set web panel title _' 'auto' 'MicroBlocks Web Panel'
  space
  spec ' ' 'webpnl add button' 'create button labelled _ with selector _ : and params _' 'auto auto auto' 'Motor' 'start motor' ''
  spec ' ' 'webpnl add toggle' 'create toggle button labelled _ with selector _ : and params _' 'auto auto auto' 'Motor' 'toggle motor' ''
  space
  spec ' ' 'webpnl add readout' 'create readout labelled _ with selector _ : and params _' 'auto auto auto' 'Temperature' 'get temperature' ''
  space
  spec 'r' '_webpnl id for selector' '_webpnl id for selector _' 'auto' 'get current humidity'
  spec ' ' '_webpnl init' '_webpnl init'
  spec 'r' '_webpnl sanitized call params' '_webpnl sanitized call params _' 'auto' ''
  spec 'r' '_webpnl unescape URL part' '_webpnl unescape URL part _' 'auto' 'an%20escaped%3Cpart%3E'
  spec ' ' '_webpnl update page cache' '_webpnl update page cache'
  spec ' ' '_webpnl webserver loop' '_webpnl webserver loop'
  spec 'r' '_webpnl html tag' '_webpnl tag _ contents _ : #BR# _ → _  : ...' 'auto auto auto auto' 'body' '' 'width' '100%'
  spec 'r' '_webpnl escaped call params' '_webpnl escaped call params _' 'auto' ''
  spec 'r' '_webpnl escaped URL part' '_webpnl escaped URL part _' 'auto' ''

to '_webpnl escaped URL part' part {
  local 'escaped' ''
  local 'escape codes' ('[data:makeList]' '%20' '%3C' '%3E' '%91' '%93' '%58')
  local 'unescaped chars' ('[data:makeList]' ' ' '<' '>' '[' ']' ':')
  for c part {
    local 'index' ('[data:find]' c (v 'unescaped chars'))
    if (index > 0) {
      escaped = ('[data:join]' escaped (at index (v 'escape codes')))
    } else {
      escaped = ('[data:join]' escaped c)
    }
  }
  return escaped
}

to '_webpnl escaped call params' params {
  local 'escaped' ''
  for param params {
    escaped = ('[data:join]' escaped '/' ('_webpnl escaped URL part' param))
  }
  return ('[data:copyFromTo]' escaped 1 ((size escaped) - 1))
}

to '_webpnl html tag' args args args args {
  local 'tag' (getArg 1)
  local 'contents' (getArg 2)
  local 'html' ('[data:join]' '<' tag)
  for index (((pushArgCount) - 2) / 2) {
    local 'attribute' (getArg ((index * 2) + 1))
    local 'value' (getArg ((index * 2) + 2))
    html = ('[data:join]' html ' ' attribute '="' value '"')
  }
  if (isType contents 'list') {
    html = ('[data:join]' html '>')
    for each contents {
      html = ('[data:join]' html each)
    }
    html = ('[data:join]' html '</' tag '>')
  } else {
    html = ('[data:join]' html '>' contents '</' tag '>')
  }
  return html
}

to '_webpnl id for selector' selector {
  local 'id' ''
  local 'suffix' 0
  for char (lowercase selector) {
    if (('[data:find]' char 'qwertyuiopasdfghjklzxcvbnm') > 0) {
      id = ('[data:join]' id char)
    } else {
      suffix += 1
    }
  }
  return ('[data:join]' id '-' (size selector) suffix)
}

to '_webpnl init' {
  if (_webpnl_title == 0) {_webpnl_title = 'MicroBlocks Web Panel'}
  if (_webpnl_readouts == 0) {_webpnl_readouts = ('[data:makeList]')}
  if (_webpnl_buttons == 0) {_webpnl_buttons = ('[data:makeList]')}
  if (_webpnl_css_style == 0) {_webpnl_css_style = 'body { background: #f0f0f0; }
#title {
  display: block;
  width: 800px;
  margin: 0 auto;
}
#panel {
  width: 800px;
  background: #fefefe;
  padding: 1em;
  margin: 1em auto;
  border-radius: 5px;
  box-shadow: 0 0 10px 0 #0005;
}
#readouts, #buttons {
  margin-bottom: 1em;
  display: table;
}
.line {
  display: table-row;
}
.label {
  display: table-cell;
  padding-right: 1em;
}
.button {
  cursor: pointer;
  background: #ededed;
  border: 1px solid #ccc;
  border-radius: 5px;
  padding: 0.1em 0.5em;
  color: #333;
}
.button.pressed {
  background: #e5e5e5;
  box-shadow: inset 0 0 5px #c1c1c1;
  color: #666;
}'}
  sendBroadcast '_webpnl webserver loop'
}

to '_webpnl sanitized call params' params {
  local 'sanitized' ('[data:makeList]')
  for param params {
    if (isDigit param) {
      '[data:addLast]' ('[data:convertType]' param 'number') sanitized
    } else {
      '[data:addLast]' ('_webpnl unescape URL part' param) sanitized
    }
  }
  return sanitized
}

to '_webpnl unescape URL part' part {
  local 'escape codes' ('[data:makeList]' '%20' '%3C' '%3E' '%91' '%93' '%58')
  local 'unescaped chars' ('[data:makeList]' ' ' '<' '>' '[' ']' ':')
  local 'unescaped part' ''
  local 'skip' 0
  for i (size part) {
    for code (v 'escape codes') {
      if (beginsWith ('[data:copyFromTo]' part i) code) {
        'unescaped part' = ('[data:join]' (v 'unescaped part') (at ('[data:find]' code (v 'escape codes')) (v 'unescaped chars')))
        skip = 3
      }
    }
    if (skip > 0) {
      skip += -1
    } else {
      'unescaped part' = ('[data:join]' (v 'unescaped part') (at i part))
    }
  }
  return (v 'unescaped part')
}

to '_webpnl update page cache' {
  _webpnl_page_cache = ('[data:join]' '<!DOCTYPE html>' ('_webpnl html tag' 'html' ('[data:makeList]' ('_webpnl html tag' 'head' ('_webpnl html tag' 'title' _webpnl_title)) ('_webpnl html tag' 'body' ('[data:makeList]' ('_webpnl html tag' 'h2' _webpnl_title 'id' 'title') ('_webpnl html tag' 'div' ('[data:makeList]' ('_webpnl html tag' 'div' ('[data:joinStrings]' _webpnl_readouts) 'id' 'readouts') ('_webpnl html tag' 'div' ('[data:joinStrings]' _webpnl_buttons) 'id' 'buttons')) 'id' 'panel'))) ('_webpnl html tag' 'style' _webpnl_css_style))))
}

to '_webpnl webserver loop' {
  '_webpnl update page cache'
  forever {
    local 'request' ('[net:httpServerGetRequest]')
    if (request != '') {
      local 'path' ('path of request' request)
      local 'path parts' ('[data:split]' ('_webpnl unescape URL part' ('[data:copyFromTo]' path 2)) '/')
      if (path == '/') {
        '[net:respondToHttpRequest]' '200 OK' _webpnl_page_cache
      } ((at 1 (v 'path parts')) == 'get') {
        '[net:respondToHttpRequest]' '200 OK' ('[data:convertType]' (callCustomReporter (at 2 (v 'path parts')) ('_webpnl sanitized call params' ('[data:copyFromTo]' (v 'path parts') 3))) 'string')
      } ((at 1 (v 'path parts')) == 'set') {
        callCustomCommand (at 2 (v 'path parts')) ('_webpnl sanitized call params' ('[data:copyFromTo]' (v 'path parts') 3))
        '[net:respondToHttpRequest]' '200 OK'
      } else {
        '[net:respondToHttpRequest]' '404 Not Found' ('[data:join]' 'Path not found: ' ('path of request' request))
      }
    }
  }
}

to 'webpnl add button' label selector params {
  '_webpnl init'
  local 'id' ('_webpnl id for selector' selector)
  '[data:addLast]' ('_webpnl html tag' 'span' ('_webpnl html tag' 'button' label 'class' 'button' 'id' id 'onclick' ('[data:join]' 'fetch(encodeURIComponent(''set/' ('_webpnl escaped URL part' selector) (ifExpression (isType params 'list') ('_webpnl escaped call params' params) '') '''));')) 'class' 'line') _webpnl_buttons
  '_webpnl update page cache'
}

to 'webpnl add readout' label selector params {
  '_webpnl init'
  local 'id' ('_webpnl id for selector' selector)
  '[data:addLast]' ('_webpnl html tag' 'span' ('[data:makeList]' ('_webpnl html tag' 'strong' label 'class' 'label') ('_webpnl html tag' 'span' '' 'id' id 'class' 'reading') ('_webpnl html tag' 'script' ('[data:join]' '(()=>{let e = document.querySelector(''#' id '''); setInterval(()=>{ fetch(''get/' ('_webpnl escaped URL part' selector) (ifExpression (isType params 'list') ('_webpnl escaped call params' params) '') ''').then(response=>{ if (response.ok) { response.text().then( text => { e.innerHTML = text; } ); } }) }, 100);})()'))) 'class' 'line') _webpnl_readouts
  '_webpnl update page cache'
}

to 'webpnl add toggle' label selector params {
  '_webpnl init'
  local 'id' ('_webpnl id for selector' selector)
  '[data:addLast]' ('_webpnl html tag' 'span' ('_webpnl html tag' 'button' label 'class' 'button' 'id' id 'onclick' ('[data:join]' '(()=>{const e = document.querySelector(''#' id '''); e.disabled=true; fetch(encodeURIComponent(''set/' ('_webpnl escaped URL part' selector) (ifExpression (isType params 'list') ('_webpnl escaped call params' params) '') ''')).then(response=>{ if (response.ok) { e.classList.toggle(''pressed''); e.disabled=false; }});})()')) 'class' 'line') _webpnl_buttons
  '_webpnl update page cache'
}

to 'webpnl set title' title {
  '_webpnl init'
  _webpnl_title = title
  '_webpnl update page cache'
}

