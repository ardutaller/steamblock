module 'Due Touch Pin'
author MicroBlocks
version 1 0 
choices dueTouch_pin P0 P1 P2 A B left right up down 
description 'Touch pin library for DUELink boards.

Works only on pins with capacitive touch circuits including pins 0, 1, 2 of the CincoBit and PixoBit and all but the SCL/SDA pins of the ClipIt.
'

  spec 'r' 'dueTouch_touched' 'due pin _  touched : threshold _' 'num.dueTouch_pin num' 0 100
  spec 'r' '_dueTouch_pulseTime' '_dueTouch_pulseTime _' 'num' 0

to '_dueTouch_pulseTime' pin {
  comment 'Charge up pin'
  digitalWriteOp pin true
  waitMicros 200
  callCustomCommand '[sensors:captureStart]' ('[data:makeList]' pin)
  waitUntil ((callCustomReporter '[sensors:captureCount]') > 0)
  local 'pulses' (callCustomReporter '[sensors:captureEnd]')
  comment 'Start charging pin'
  digitalWriteOp pin true
  return (at 1 pulses)
}

to dueTouch_touched pin optionalThreshold {
  if ('P0' == pin) {
    pin = 0
  } ('P1' == pin) {
    pin = 1
  } ('P2' == pin) {
    pin = 2
  } ('P3' == pin) {
    pin = 3
  } ('A' == pin) {
    pin = 10
  } ('B' == pin) {
    pin = 24
  } ('left' == pin) {
    pin = 14
  } ('right' == pin) {
    pin = 12
  } ('up' == pin) {
    pin = 13
  } ('down' == pin) {
    pin = 18
  }
  local 'pTime' ('_dueTouch_pulseTime' pin)
  if (pTime < 0) {
    comment 'Negative pulse time glitch; try again'
    pTime = ('_dueTouch_pulseTime' pin)
  }
  waitMillis 5
  return (pTime > (argOrDefault 2 100))
}

