module 'CoCube Module'
author 'Liang Shuai'
version 1 4 
depends Servo NeoPixel 'Robots/CoCube' 'Sensing/Distance (HC-SR04)' 'Other/System/sensorPrims' 
description 'External modules of CoCube'

  spec ' ' 'ccmodule_Power on module' 'Power on module'
  spec ' ' 'ccmodule_Power off module' 'Power off module'
  space
  spec ' ' 'ccmodule_Gripper Open' 'Gripper Open'
  spec ' ' 'ccmodule_Gripper Close' 'Gripper Close'
  spec ' ' 'ccmodule_Gripper degree' 'Gripper degrees _ (-70 to 0)' 'num' 0
  space
  spec ' ' 'ccmodule_attach NeoPixel' 'attach NeoPixel'
  spec ' ' 'ccmodule_set all NeoPixels color' 'set all NeoPixels color _' 'color'
  spec ' ' 'ccmodule_clear NeoPixels' 'clear NeoPixels'
  space
  spec 'r' 'ccmodule_Ultrasonic distance (cm)' 'Ultrasonic distance (cm)'
  space
  spec 'r' 'ccmodule_Ambient Light' 'Ambient Light'

to 'ccmodule_Ambient Light' {
  i2cSet (hexToInt '23') 23 (hexToInt '21')
  read = (newList 2)
  '[sensors:i2cRead]' (hexToInt '23') read
  return (((at 1 read) << 8) | (at 2 read))
}

to 'ccmodule_Gripper Close' {
  setServoAngle 22 -70
}

to 'ccmodule_Gripper Open' {
  setServoAngle 22 0
}

to 'ccmodule_Gripper degree' degree {
  if (degree < -70) {
    setServoAngle 22 -70
  } (degree > 0) {
    setServoAngle 22 0
  } else {
    setServoAngle 22 degree
  }
}

to 'ccmodule_Power off module' {
  digitalWriteOp 13 false
}

to 'ccmodule_Power on module' {
  digitalWriteOp 13 true
}

to 'ccmodule_Ultrasonic distance (cm)' {
  return ('distance (cm)' 21 22)
}

to 'ccmodule_attach NeoPixel' {
  neoPixelAttach 64 22
}

to 'ccmodule_clear NeoPixels' {
  clearNeoPixels
}

to 'ccmodule_set all NeoPixels color' color {
  neoPixelSetAllToColor color
}

