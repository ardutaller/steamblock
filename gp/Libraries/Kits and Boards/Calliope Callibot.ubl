module 'Calliope Callibot'
author 'Michael Klein (kleinswelt)'
version 1 1 
choices cb_V1intensity '0' '1' '2' '3' '4' '5' '6' '7' '8' 
choices cb_motor left right both 
choices cb_line 'mk2;bright' 'mk2;dark' 
choices cb_direction forward backward 
choices cb_V1color red green blue yellow violett aqua white black 
choices cb_RGBLed 'left front' 'right front' 'left back' 'right back' all 
choices cb_servo 'mk2;S1' 'mk2;S2' both 
choices cb_position left right 
description 'Calliope Calli:bot 1&2
These are blocks for driving the fully I2C controlled 
Calliope mini Calli:bot V1, V2 and V2E from Knotech.

https://shop.knotech.de/calli-bot
'
variables _ledState_ 

  spec ' ' 'cb_setMotor' 'Callibot motor _ dir _ speed _ (0~255)' 'menu.cb_motor menu.cb_direction num' 'both' 'forward' 255
  spec ' ' 'cb_stopMotor' 'Callibot stop motor _' 'menu.cb_motor' 'both'
  spec ' ' 'cb_setServo' 'Callibot set servo _ to _ ° (0~180)' 'menu.cb_servo auto' 'mk2;S1' '90'
  space
  spec 'r' 'cb_distance' 'Callibot distance (cm)'
  spec 'r' 'cb_lineSensor' 'Callibot line sensor _ _' 'menu.cb_position menu.cb_line' 'left' 'mk2;dark'
  spec 'r' 'cb_bumper' 'Callibot V2 bumper _ _' 'menu.cb_position bool' 'left' true
  space
  spec ' ' 'cb_setLED' 'Callibot LED _ _' 'menu.cb_motor bool' 'both' true
  spec ' ' 'cb_1setNeopixel' 'Callibot set neopixel _ to _ intensity _' 'menu.cb_RGBLed menu.cb_V1color menu.cb_V1intensity' 'all' 'red' '3'
  spec ' ' 'cb_clearNeoPixels' 'Callibot clear NeoPixels'
  spec ' ' 'cb_setNeoPixel' 'Callibot V2 set neopixel _ to _' 'menu.cb_RGBLed color' 'all'
  spec 'r' 'cb_colorRGB' 'color r _ g _ b _ (0~255)' 'num num num' 0 100 100
  space
  spec ' ' 'cb_resetEncodercounter' 'Callibot V2E reset encodercounter _' 'menu.cb_motor auto' 'both'
  spec 'r' 'cb_encodercounter' 'Callibot V2E encodercounter _' 'menu.cb_position' 'left'
  spec 'r' '_cb_battery' 'Callibot V2E battery (mV)'
  space
  space
  spec 'r' '_cb_initialized' '_cb_initialized'
  spec 'r' '_callibotv2_' '_callibotv2_'
  spec 'r' '_cb_i2cRead' '_cb_i2cRead addr _ reg _' 'num num'
  spec ' ' '_cb_i2cWrite' '_cb_i2cWrite addr _ list _' 'num num'

to '_callibotv2_' {
  if ('_cb_initialized') {
    local 'buffer' ('_cb_i2cRead' (hexToInt '21') 1)
    return (((at 1 buffer) & (hexToInt '80')) != 0)
  }
}

to '_cb_battery' {
  if ('_callibotv2_') {
    '_cb_i2cWrite' (hexToInt '22') ('[data:makeList]' (hexToInt '83'))
    local 'mv' (newList 3)
    i2cSet (hexToInt '22') 3 0
    '[sensors:i2cRead]' (hexToInt '22') mv
  }
  return (((at 3 mv) << 8) + (at 2 mv))
}

to '_cb_i2cRead' cbi2cAddr regAddr {
  comment 'Read four registers starting at the given address and return a list of their values.'
  local 'result' (newList 4)
  if ('_cb_initialized') {
    i2cSet cbi2cAddr regAddr 0
    '[sensors:i2cRead]' cbi2cAddr result
  }
  '[sensors:i2cSetClockSpeed]' 400000
  return result
}

to '_cb_i2cWrite' cbi2cAddr writeBuffer {
  comment 'Write data. The first byte of writeBuffer is the destination register followed by the bytes to be written.'
  if ('_cb_initialized') {
    '[sensors:i2cWrite]' cbi2cAddr writeBuffer
  }
  '[sensors:i2cSetClockSpeed]' 400000
}

to '_cb_initialized' {
  '[sensors:i2cSetClockSpeed]' 100000
  return ('[sensors:i2cExists]' (hexToInt '20'))
}

to cb_1setNeopixel LED colorname intensity {
  if ('_cb_initialized') {
    intensity = ('[data:convertType]' intensity 'number')
    intensity = (maximum 0 (minimum intensity 8))
    if (intensity > 0) {
      intensity = (((intensity * 2) - 1) * 16)
    }
    if (colorname == 'red') {
      colorname = ('[data:convertType]' 2 'number')
    } (colorname == 'black') {
      colorname = ('[data:convertType]' 7 'number')
      intensity = 0
    } (colorname == 'green') {
      colorname = ('[data:convertType]' 1 'number')
    } (colorname == 'blue') {
      colorname = ('[data:convertType]' 4 'number')
    } (colorname == 'yellow') {
      colorname = ('[data:convertType]' 3 'number')
    } (colorname == 'aqua') {
      colorname = ('[data:convertType]' 5 'number')
    } (colorname == 'violett') {
      colorname = ('[data:convertType]' 6 'number')
    } (colorname == 'white') {
      colorname = ('[data:convertType]' 7 'number')
    }
    if (LED == 'left front') {
      LED = ('[data:convertType]' 1 'number')
    } (LED == 'left back') {
      LED = ('[data:convertType]' 2 'number')
    } (LED == 'right front') {
      LED = ('[data:convertType]' 4 'number')
    } (LED == 'right back') {
      LED = ('[data:convertType]' 3 'number')
    } else {
      LED = ('[data:convertType]' 5 'number')
    }
    if (LED == 5) {
      '_cb_i2cWrite' (hexToInt '21') ('[data:makeList]' 1 (intensity | colorname) (intensity | colorname) (intensity | colorname) (intensity | colorname))
    } else {
      '_cb_i2cWrite' (hexToInt '21') ('[data:makeList]' LED (intensity | colorname))
    }
  }
}

to cb_bumper sensorlr sstate {
  if ('_callibotv2_') {
    local 'buffer' ('_cb_i2cRead' (hexToInt '21') 0)
    if (sensorlr == 'left') {
      if (sstate == (booleanConstant true)) {
        return (((at 1 buffer) & 8) != 0)
      } else {
        return (not (((at 1 buffer) & 8) != 0))
      }
    } else {
      if (sstate == (booleanConstant true)) {
        return (((at 1 buffer) & 4) != 0)
      } else {
        return (not (((at 1 buffer) & 4) != 0))
      }
    }
  } else {
    return (booleanConstant false)
  }
}

to cb_clearNeoPixels {
  cb_1setNeopixel 'all' 'black' '0'
}

to cb_colorRGB r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return (((r << 16) | (g << 8)) | b)
}

to cb_distance {
  if ('_cb_initialized') {
    local 'buffer' ('_cb_i2cRead' (hexToInt '21') 3)
    distance = ((((at 2 buffer) << 8) | (at 3 buffer)) / 10)
    if (distance > 399) {
      comment 'Return maximum value'
      distance = 400
    }
    if (distance < 1) {
      comment 'Return -1 if distance is invalid'
      distance = -1
    }
    return distance
  }
}

to cb_encodercounter encoderlr {
  if ('_callibotv2_') {
    local 'result' (newList 9)
    if (encoderlr == 'left') {
      local 'index' 2
    } else {
      local 'index' 6
    }
    if ('_cb_initialized') {
      i2cSet (hexToInt '22') (hexToInt '91') 0
      '[sensors:i2cRead]' (hexToInt '22') result
    }
    '[sensors:i2cSetClockSpeed]' 400000
    local 'encodercount' (at (index + 3) result)
    encodercount = ((encodercount * 256) + (at (index + 2) result))
    encodercount = ((encodercount * 256) + (at (index + 1) result))
    encodercount = ((encodercount * 256) + (at index result))
    return encodercount
  } else {
    return 0
  }
}

to cb_lineSensor which brightdark {
  if ('_cb_initialized') {
    local 'patrol' (at 1 ('_cb_i2cRead' (hexToInt '21') 1))
    if (which == 'left') {
      patrol = (patrol & 2)
    } else {
      patrol = (patrol & 1)
    }
    local 'var' (patrol == 0)
    if (brightdark == 'mk2;bright') {
      var = (not var)
    }
    return var
  }
}

to cb_resetEncodercounter encoderlrb {
  if ('_callibotv2_') {
    if (encoderlrb == 'left') {
      local 'lrb' 1
    } (encoderlrb == 'right') {
      local 'lrb' 2
    } else {
      local 'lrb' 3
    }
    '_cb_i2cWrite' (hexToInt '22') ('[data:makeList]' 5 lrb)
  }
}

to cb_setLED which on {
  if ('_cb_initialized') {
    if (which == 'left') {
      if on {
        _ledState_ = (_ledState_ | 1)
      } else {
        _ledState_ = (_ledState_ & (hexToInt 'fe'))
      }
    } (which == 'right') {
      if on {
        _ledState_ = (_ledState_ | 2)
      } else {
        _ledState_ = (_ledState_ & (hexToInt 'fd'))
      }
    } else {
      if on {
        _ledState_ = (_ledState_ | 3)
      } else {
        _ledState_ = (_ledState_ & (hexToInt 'fc'))
      }
    }
    '_cb_i2cWrite' (hexToInt '21') ('[data:makeList]' 0 _ledState_)
  }
}

to cb_setMotor motor dir speed {
  if ('_cb_initialized') {
    speed = (maximum 0 (minimum speed 255))
    dir = ('[data:convertType]' (dir != 'forward') 'number')
    if (motor == 'left') {
      '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '00') dir speed)
    } (motor == 'right') {
      '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '02') dir speed)
    } else {
      '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '00') dir speed dir speed)
    }
  }
}

to cb_setNeoPixel LED color {
  if ('_callibotv2_') {
    local 'r' (((color >> 16) & 255) / 16)
    local 'g' (((color >> 8) & 255) / 16)
    local 'b' ((color & 255) / 16)
    if (LED == 'left front') {
      local 'pos' 1
    } (LED == 'left back') {
      local 'pos' 2
    } (LED == 'right front') {
      local 'pos' 4
    } (LED == 'right back') {
      local 'pos' 3
    } (LED == 'all') {
      for i 4 {
        '_cb_i2cWrite' (hexToInt '22') ('[data:makeList]' 3 i r g b)
      }
      stopTask
    }
    '_cb_i2cWrite' (hexToInt '22') ('[data:makeList]' 3 pos r g b)
  }
}

to cb_setServo servo degrees {
  if ('_cb_initialized') {
    degrees = (maximum 0 (minimum degrees 180))
    if (servo == 'mk2;S1') {
      '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '14') degrees)
    } (servo == 'mk2;S2') {
      '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '15') degrees)
    } else {
      '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '14') degrees degrees 0)
    }
  }
}

to cb_stopMotor motor {
  if (motor == 'left') {
    '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '00') 0 0)
  } (motor == 'right') {
    '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '02') 0 0)
  } else {
    '_cb_i2cWrite' (hexToInt '20') ('[data:makeList]' (hexToInt '00') 0 0 0 0 0)
  }
}

