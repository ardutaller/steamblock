module 'Air Pressure (BMP581)' Input
author MicroBlocks
version 1 0 
description ''

  spec 'r' 'bmp581_pressure' 'bmp581_pressure'
  spec 'r' 'bmp581_temperature' 'bmp581_temperature (x10)'
  space
  spec ' ' '_bmp581_init' '_bmp581_init'
  spec 'r' '_bmp581_readData' '_bmp581_readData'

to '_bmp581_init' {
  local 'bmp581_addr' (hexToInt '46')
  comment 'Soft reset'
  i2cSet bmp581_addr (hexToInt '7E') (hexToInt 'B6')
  comment 'wait for status_nvm_rdy (datasheet 4.3.9)'
  waitUntil ((i2cGet bmp581_addr (hexToInt '28')) == 2)
  comment 'enable pressure readings'
  i2cSet bmp581_addr (hexToInt '36') (hexToInt '40')
  comment 'Set up IIR filtering'
  i2cSet bmp581_addr (hexToInt '31') ((2 << 3) | 2)
  i2cSet bmp581_addr (hexToInt '30') ((1 << 5) | ((1 << 3) | 3))
  comment 'Continuous filtering, 240 Hz'
  i2cSet bmp581_addr (hexToInt '37') 1
}

to '_bmp581_readData' {
  local 'bmp581_addr' (hexToInt '46')
  if (((i2cGet bmp581_addr (hexToInt '37')) & 3) != 1) {
    comment 'Initialize if needed (i.e. mode is not "continuous")'
    '_bmp581_init'
    waitMillis 5
  }
  comment 'wait for fresh data'
  waitUntil (((i2cGet bmp581_addr (hexToInt '27')) & 2) == 0)
  local 'data' ('[data:newByteArray]' 6)
  '[sensors:i2cWrite]' bmp581_addr (hexToInt '1D')
  '[sensors:i2cRead]' bmp581_addr data
  return data
}

to bmp581_pressure {
  local 'data' ('_bmp581_readData')
  comment '24-big signed value, 16-bits of fraction'
  local 'result' ((((at 6 data) << 16) | ((at 5 data) << 8)) | (at 4 data))
  comment 'result is pressure in Pascals
(millibars x 100)'
  return (result >> 6)
}

to bmp581_temperature {
  local 'data' ('_bmp581_readData')
  comment '24-big signed value, 16-bits of fraction'
  local 'result' ((((at 3 data) << 16) | ((at 2 data) << 8)) | (at 1 data))
  comment 'sign extend 24 bit value'
  result = ((result << 7) >> 7)
  comment 'result is degrees C x 10'
  return ((10 * result) >> 16)
}

